# Godot 4+ specific ignores
.godot/
/android/

# Exports
/build/
/exports/
*.pck
*.exe
*.zip

# OS / editor
.DS_Store
Thumbs.db
*.tmp
.vscode/

# Licensed sound pack: usable in the game, but the original files must not be
# shared, and this repo is public. tools/copy_sfx.sh copies the used sounds.
/Sound FX Starter Pack Vol. 1/
/assets/audio/sfx/*.wav
/assets/audio/sfx/*.wav.import
/assets/audio/ambience/*.wav
/assets/audio/ambience/*.wav.import

# Art program preview sheets (tools/pixel/run.gd --preview)
tools/pixel/preview/

# Pictures from an image model (tools/pixel/generate.gd): big, kept locally only.
/assets/art/_generated_raw/*
!/assets/art/_generated_raw/.gdignore
