[resource]
script = ExtResource("1_def")
id = &"flesh_tenders"
display_name = "Flesh-Tenders"
member_name = "a Flesh-Tender"
description = "Farmers of the gut lining. They grow food in the god's own tissue, drain its bile into cisterns, and bury their dead in the walls so the body can use them."
creed = "The god is soil, not a sleeper. Tend it, take only what grows back, waste nothing. What dies here feeds what lives here."
color = Color(0.44, 0.69, 0.29, 1)
values = Array[StringName]([&"tending", &"patience", &"waste_not", &"the_dead_feed_the_body"])
aggression = 0.25
expansion = 0.45
piety = 0.3
trade = 0.7
senses_fragment = 0.0
npc_frames_dir = "res://assets/art/npcs/tender"
settlement_props = Array[PackedScene]([ExtResource("2_tent"), ExtResource("3_plot"), ExtResource("4_cistern"), ExtResource("5_rack"), ExtResource("6_lamp")])
barks = Array[String](["Mind the bile, it eats boots.", "The lining is soft this season.", "Whatever falls here feeds the walls.", "Don't waste it. Nothing grows back twice.", "You smell of the Choir's candles.", "Pull the bulbs gently, they bruise.", "Bury me in the east wall, where it's warm."])
strength = 120
relations = {
&"choir_of_waking": -20
}
host_attitudes = {
&"antibody": -40,
&"colonist": 20,
&"pilgrim": -10
}
