[gd_resource type="Resource" script_class="ItemDef" format=3]

[ext_resource type="Script" path="res://src/items/item_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"wind_bladder"
display_name = "Wind Bladder"
description = "A bladder from a Lung-creature's throat, taut with old breath. Edible, if you can keep it down."
color = Color(0.84, 0.86, 0.9, 1)
grants_mutation = &"gust_bladder"
