[gd_scene format=3]

[ext_resource type="Script" path="res://src/arena.gd" id="1_arena"]
[ext_resource type="PackedScene" path="res://scenes/backdrop.tscn" id="2_backdrop"]
[ext_resource type="TileSet" path="res://assets/art/tiles/gut_tileset.tres" id="3_tiles"]
[ext_resource type="PackedScene" path="res://src/actors/player/player.tscn" id="4_player"]
[ext_resource type="Script" path="res://src/actors/components/combat_feel.gd" id="5_feel"]
[ext_resource type="PackedScene" path="res://src/ui/hud.tscn" id="6_hud"]
[ext_resource type="PackedScene" path="res://src/actors/bosses/gullet_matron.tscn" id="9_boss"]
[ext_resource type="PackedScene" path="res://src/camera/game_camera.tscn" id="90_camera"]

[node name="BossArena" type="Node2D"]
script = ExtResource("1_arena")
arena_name = "The Gullet Matron's pit"
layout = "######################################
#....................................#
#....................................#
#....................................#
#....................................#
#....................................#
#....................................#
#....................................#
#....................................#
#....................................#
#....................................#
######################################"
player_health = 6
mutations = Array[StringName]([&"acid_gland", &"bone_spur"])
friendly_fire = true

[node name="Backdrop" parent="." instance=ExtResource("2_backdrop")]

[node name="Darkness" type="CanvasModulate" parent="."]
color = Color(0.62, 0.5, 0.55, 1)

[node name="Terrain" type="TileMapLayer" parent="."]
tile_set = ExtResource("3_tiles")

[node name="Enemies" type="Node2D" parent="."]

[node name="GulletMatron" parent="Enemies" instance=ExtResource("9_boss")]
wake_range = 2000.0
position = Vector2(900, 358)

[node name="PlayerSpawn" type="Marker2D" parent="."]
position = Vector2(120, 326)

[node name="Player" parent="." instance=ExtResource("4_player")]

[node name="GameCamera" parent="." node_paths=PackedStringArray("target") instance=ExtResource("90_camera")]
target = NodePath("../Player")

[node name="CombatFeel" type="Node" parent="." node_paths=PackedStringArray("player", "camera")]
script = ExtResource("5_feel")
player = NodePath("../Player")
camera = NodePath("../GameCamera")

[node name="UI" type="CanvasLayer" parent="."]
layer = 10

[node name="HUD" parent="UI" instance=ExtResource("6_hud")]
